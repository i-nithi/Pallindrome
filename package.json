{
  "name": "palindrome-labs",
  "private": true,
  "version": "4.0.0",
  "description": "Static website for Pallindrome",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "esbuild static/ts/main.ts --bundle --minify --format=iife --target=es2022 --outfile=static/js/main.js && node scripts/build.mjs",
    "preview": "npx serve dist"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/three": "^0.174.0",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2"
  }
}
